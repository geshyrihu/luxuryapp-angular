{
  /* To learn more about this file see: https://angular.io/config/tsconfig. */
  // Evita recompilar automáticamente cuando se guardan archivos. Útil en desarrollo.
  "compileOnSave": true,

  "exclude": ["**/*.spec.ts"],
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": false,
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "paths": {
      "src/*": ["./src/*"],
      "@ui/*": ["./src/app/shared/ui/*"]
    },
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["es2023", "dom", "dom.iterable"]
  },

  "angularCompilerOptions": {
    // Desactiva el formato de identificadores de mensajes heredado en i18n.
    "enableI18nLegacyMessageIdFormat": false,

    // Muestra errores si los parámetros del constructor no son válidos para inyección de dependencias.
    "strictInjectionParameters": true,

    // Requiere que los inputs tengan modificadores de acceso válidos (ej. public/private).
    "strictInputAccessModifiers": true,

    // Activado temporalmente (2026-08-11) solo para la migracion de iconos y
    // devuelto a false al cerrarla. Los nombres de icono quedaron en 0
    // pendientes, pero NO gracias a este interruptor: casi ningun literal
    // llega por un input tipado, asi que el compilador nunca los vio. Lo que
    // los cubre hoy es `npm run audit:icon-names`.
    //
    // Con true afloran 763 defectos ajenos a iconos (169 variant="outlined"
    // que renderizan solidos, 142 string-como-boolean, 100 signals sin
    // invocar...). Son reales y estan documentados en
    // docs/plans/20260809-design-system-remediacion-integral-plan.md;
    // mientras siga en false, ninguna plantilla de la app se valida.
    "strictTemplates": false
  }
}
