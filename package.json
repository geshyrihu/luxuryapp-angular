{
  "name": "luxury-app",
  "version": "5.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "audit:emoji": "node scripts/audit-emoji-usage.mjs",
    "audit:css": "npx -y tsx scripts/audit-css-classes.ts",
    "audit:encoding": "node scripts/audit-encoding.mjs",
    "audit:ui": "node scripts/audit-ui-boundaries.mjs",
    "audit:apps": "node scripts/audit-apps-boundaries.mjs",
    "audit:design": "node scripts/audit-design-system.mjs",
    "audit:tokens": "node scripts/audit-ds-tokens.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:token-refs": "node scripts/audit-token-refs.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:design-conventions": "node scripts/audit-design-conventions.mjs",
    "extract:design-conventions": "node scripts/extract-design-conventions.mjs",
    "lint": "npm run audit:encoding && npm run audit:emoji && npm run audit:css && npm run audit:ui && npm run audit:apps && npm run audit:design && npm run audit:tokens",
    "audit:frontend": "node scripts/audit-frontend-senior.mjs",
    "audit:mobile": "node scripts/audit-mobile-developer.mjs",
    "audit:full-stack": "npm run audit:frontend && npm run audit:mobile && echo '✅ Frontend audits passed'",
    "watch": "ng build --watch --configuration development",
    "test": "node --max-old-space-size=8192 node_modules/vitest/vitest.mjs",
    "test:coverage": "node --max-old-space-size=8192 node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ci": "playwright test --reporter=github",
    "test:e2e:install": "playwright install",
    "test:e2e:report": "playwright show-report",
    "storybook": "ng run luxury-app:storybook",
    "build-storybook": "ng run luxury-app:build-storybook",
    "audit:scss-build": "node scripts/audit-scss-build.mjs",
    "audit:icon-names": "node scripts/audit-icon-names.mjs",
    "audit:ds": "npm run audit:scss-build && npm run audit:tokens && npm run audit:contrast && npm run audit:token-refs && npm run audit:icon-names"
  },
  "private": true,
  "dependencies": {
