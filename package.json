    "@swimlane/ngx-graph": "^12.0.0-alpha.2",
    "@types/qrcode": "^1.5.6",
    "angularx-flatpickr": "^8.1.0",
    "animate.css": "^4.1.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
