    "jasmine-core": "6.3.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "17.0.0",
    "jsdom": "29.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
